# Export these before running (or set in your host's dashboard)
DATABASE_URL=jdbc:postgresql://localhost:5432/glintly
DB_USER=glintly
DB_PASS=glintly
JWT_SECRET=change-me-to-64-random-chars
GOOGLE_WEB_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
ADMIN_KEY=change-me-long-random
# Numeric part of your rewarded ad unit ID (ca-app-pub-XXXX/1234567890 -> 1234567890)
ADMOB_REWARDED_UNIT_ID=1234567890
PUBLIC_BASE_URL=https://api.yourdomain.com
# Economy (tune to your eCPM!)
REWARD_PER_AD=5
MAX_ADS_PER_DAY=30
AD_COOLDOWN_SEC=30
MAX_TASKS_PER_DAY=10
CREDITS_PER_USD=1000
MIN_WITHDRAW_CREDITS=5000
